generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Plan called for a `directUrl` (Neon's unpooled connection string) here
  // for more reliable `migrate deploy` runs. Verified against this project's
  // actual Prisma 7 version: @prisma/config's Datasource type only supports
  // `url`/`shadowDatabaseUrl` — directUrl has no equivalent in config-file
  // mode (schema-level `directUrl` is explicitly rejected: P1012, "no longer
  // supported in schema files"). Not added — flagged as unsupported in the
  // final report rather than forced in against what the tool actually allows.
}

enum Role {
  ADMIN
  EDITOR
  REPORTER
  RESEARCHER
  // Zero capabilities — not included in any CAN_* list in lib/permissions.ts.
  // Exists solely so automated actions (cron, etc.) have a valid,
  // non-nullable AuditLog.userId. Seeded once, active:false, unusable
  // passwordHash — see lib/system-actor.ts. Never selectable/assignable via
  // any admin UI or action (enforced server-side, not just hidden client-side).
  SYSTEM
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  // Distinct from ARCHIVED (published, then pulled) — reachable only from
  // IN_REVIEW/CHANGES_REQUESTED, meaning it never had a live publish.
  REJECTED
}

enum SourceType {
  RSS
  ATOM
  COMPANY_NEWSROOM
  OFFICIAL_BLOG
  API
  OTHER
  // A Source of this type stores no feedUrl — its query is computed live
  // at ingest time from its Category's active TOPIC-type Keyword rows (see
  // lib/ingestion/google-news.ts's buildGoogleNewsQuery), not a stored feed
  // URL, since the query composition can change as keywords are edited.
  GOOGLE_NEWS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  CONFLICT
  UNVERIFIED
}

enum AIStatus {
  NOT_STARTED
  PROCESSING
  COMPLETE
  FAILED
}

enum SourceTier {
  TIER_1
  TIER_2
  TIER_3
}

enum DiscoveryStatus {
  NEW
  REVIEWING
  VERIFIED
  DUPLICATE
  POSSIBLE_DUPLICATE
  REJECTED
  CONVERTED_TO_DRAFT
}

enum PakistanImpactLevel {
  DIRECT
  HIGH
  MODERATE
  LOW
  NONE
}

enum ClaimType {
  FACT
  CLAIM
  SPECULATION
  UNVERIFIED
}

enum ClaimStance {
  SUPPORTING
  CONTRADICTING
}

// Outcome of lib/ai/verify-and-synthesize.ts checking a discovered story
// against a known-official (Source.tier = TIER_1) primary source before
// TEKZARO publishes its own synthesis of it. PRIMARY_SOURCE_CONFIRMED is
// the only status the auto-publish gate (lib/verification-actions.ts) will
// ever act on by itself — every other value routes to human review.
enum ArticleVerificationStatus {
  UNVERIFIED
  PRIMARY_SOURCE_CONFIRMED
  PRIMARY_SOURCE_NOT_FOUND
  CONTRADICTION_FOUND
}

enum AITask {
  SUMMARIZE
  EXTRACT_ENTITIES
  CLASSIFY_TOPIC
  EXTRACT_CLAIMS
  HEADLINE_SUGGESTIONS
  PAKISTAN_IMPACT
  INTERNAL_LINKS
  VERIFY_PRIMARY_SOURCE
  SYNTHESIZE_ARTICLE
}

enum KeywordType {
  PAKISTAN
  COMPANY
  TOPIC
}

enum DigestSection {
  PAKISTAN
  REGIONAL
  GLOBAL
}

enum DigestStatus {
  DRAFT
  READY
}

enum PasswordResetPurpose {
  INVITE
  RESET
}

enum EmailStatus {
  SENT
  FAILED
  NOT_CONFIGURED
  // Deliberately not attempted, so not a failure: an RFC 2606 reserved
  // recipient (example.com, .test, .invalid) that can never receive mail,
  // or a test run. Distinct from FAILED because counting these as failures
  // is what buried real delivery problems in noise — and attempting them
  // is what damaged the sender's reputation with rejections.
  SKIPPED
}

enum NewsletterCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum SystemEventLevel {
  INFO
  WARN
  ERROR
}

enum NewsletterSubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

// Public accessibility is never interpreted as reuse permission. UNKNOWN is
// the default for every automatically acquired image — an absent grant is
// non-publishable, not neutral. Only ALLOWED/LICENSED/OWNED/GENERATED may
// ever reach Article.featuredImageUrl (see lib/publication-checks.ts).
enum ImageReuseStatus {
  UNKNOWN
  ALLOWED
  LICENSED
  OWNED
  GENERATED
  REQUIRES_REVIEW
  REJECTED
}

enum AdvertiserStatus {
  ACTIVE
  INACTIVE
}

// Only the human-driven part of the lifecycle is persisted. SCHEDULED /
// ACTIVE / EXPIRED are never stored — they're computed live from an
// APPROVED campaign's startDate/endDate against the current time (see
// lib/ads.ts's computeAdRuntimeStatus), same "compute at render, no cron"
// philosophy as the Daily Editorial Checklist. PAUSED is the one manual
// override: an editor can halt delivery mid-flight without losing the
// campaign's date range or needing to re-approve it afterward.
enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
}

// A small, fixed set of slots that already exist in the real page
// layouts — not a generic placement system. Add a new value here only
// when a real slot is added to a real page.
enum AdPlacement {
  HOMEPAGE_FEED
  CATEGORY_TOP
  ARTICLE_END
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(REPORTER)
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // True right after bootstrap/creation — forces a password change before
  // any other admin page is usable. Cleared by changePasswordAction.
  mustChangePassword  Boolean   @default(false)
  // Set on every successful login (lib/auth-actions.ts). Display-only —
  // never used for any access decision.
  lastLoginAt         DateTime?
  authorId            String?
  author              Author?   @relation(fields: [authorId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditLogs           AuditLog[]
  versions            ArticleVersion[]
  sessions            Session[]
  createdArticles     Article[]            @relation("ArticleCreatedBy")
  reviewedItems       SourceItem[]         @relation("SourceItemReviewedBy")
  claims              Claim[]
  aiGenerations       AIGeneration[]
  digests             Digest[]
  digestItemsAdded    DigestItem[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  uploadedMedia       Media[]
  newsletterCampaigns NewsletterCampaign[]
  createdAdCampaigns  AdCampaign[]         @relation("AdCampaignCreatedBy")
  reviewedAdCampaigns AdCampaign[]         @relation("AdCampaignReviewedBy")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?
  articles    Article[]
  sourceItems SourceItem[]
  sources     Source[]
  adCampaigns AdCampaign[]
  keywords    Keyword[]

  // General editorial-use toggle (mirrors Source.active/Keyword.active) —
  // separate from participatesInQuota so a real, active category can opt
  // out of daily-target tracking specifically without being deactivated.
  active Boolean @default(true)

  // Daily Editorial Checklist config (lib/editorial-checklist.ts). Changes
  // are logged to AuditLog (category_quota_updated) — see
  // updateCategoryAction in lib/category-actions.ts.
  dailyTarget                      Int     @default(2)
  participatesInQuota              Boolean @default(true)
  // When true, a published article only counts toward this category's
  // daily quota if verificationStatus === PRIMARY_SOURCE_CONFIRMED — a
  // real, enforced per-category verification bar, not just documentation.
  requirePrimarySourceVerification Boolean @default(false)
  // Admin-authored guidance shown on the checklist. Deliberately NOT an
  // enforced threshold — there is no existing measurable "quality score"
  // in this schema to gate on, and inventing one now would be a separate
  // feature, not a config knob.
  minQualityNote                   String?

  eligibleAuthors Author[] @relation("AuthorCategoryEligibility")

  // Public-site navigation, replacing the formerly-hardcoded CATEGORIES/
  // PRIMARY_NAV/OVERFLOW_NAV arrays in lib/constants.ts — see lib/categories.ts.
  // null navPriority / showInPrimaryNav=false = not shown in primary nav at
  // all (a category can exist for internal/quota purposes without being
  // publicly navigable); lower navPriority sorts earlier.
  navPriority      Int?
  showInPrimaryNav Boolean @default(false)
  // Distinguishes a category with its own dedicated hub route (e.g.
  // Pakistan Tech's /pakistan-tech) from the generic /category/:slug path,
  // without hardcoding the specific slug anywhere in nav-building code.
  customRoute      String?
}

// Singleton — nothing like a site-settings model exists elsewhere in this
// schema, and a general-purpose settings system would be overbuilt for the
// one field this feature needs. Literal id (not cuid()) so every read/write
// targets the same self-documenting, lookup-free row. See
// lib/editorial-settings.ts (lazy-default reads, no lazy-create — a plain
// read never writes) / lib/editorial-settings-actions.ts (the one write path).
model EditorialSettings {
  id        String   @id @default("singleton")
  timezone  String   @default("Asia/Karachi")
  updatedAt DateTime @updatedAt
}

// Singleton, same shape/rationale as EditorialSettings above. Separate model
// rather than adding fields there — EditorialSettings is documented as
// scoped to display-timezone only, and these two intervals have distinct
// cost profiles (ingestion is free, verify-and-publish spends a paid Tavily
// search credit per item) that warrant independently tunable cadences. See
// lib/pipeline-schedule.ts (lazy-default reads) / the cron routes' no-op
// fast-paths in app/api/cron/{ingest-news,verify-and-publish}/route.ts.
model PipelineSchedule {
  id                       String    @id @default("singleton")
  ingestionIntervalMinutes Int       @default(60)
  verifyIntervalMinutes    Int       @default(60)
  lastIngestionRunAt       DateTime?
  lastVerifyRunAt          DateTime?
  updatedAt                DateTime  @updatedAt
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
}

model Author {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  photoUrl    String?
  bio         String?
  position    String?
  socialLinks Json?
  articles    Article[]
  users       User[]

  // Soft-toggle only (mirrors User.active/Source.active/Keyword.active),
  // never a hard delete — authorId is a required FK on Article, and any
  // real author will accumulate published articles a hard delete would be
  // blocked by anyway. See lib/author-actions.ts's setAuthorActiveAction.
  active Boolean @default(true)

  // Category-eligibility allowlist (lib/author-eligibility.ts). An empty
  // list means eligible for EVERY category — default-permissive, not
  // default-restrictive, since every existing Author row has zero links
  // and a restrictive default would make every current author instantly
  // unassignable the moment this migration runs.
  categories Category[] @relation("AuthorCategoryEligibility")
}

model Article {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  subheadline String?
  excerpt     String?
  content     Json

  status     ArticleStatus @default(DRAFT)
  isBreaking Boolean       @default(false)
  featured   Boolean       @default(false)
  // True only for seeded placeholder content (spec: demo content must be
  // clearly labeled and never presented as real current news). Real
  // newsroom-authored articles always leave this false.
  isDemo     Boolean       @default(false)

  // True only when lib/verification-actions.ts's processVerificationBatch
  // published this article itself, with no human ever touching the
  // DRAFT -> PUBLISHED transition. Admin-visible (mirrors the isDemo badge
  // convention) so an auto-published article is never mistaken for
  // human-vetted work.
  autoPublished            Boolean                   @default(false)
  verificationStatus       ArticleVerificationStatus @default(UNVERIFIED)
  // The official/primary URL verification found corroborating this story,
  // if any — shown in the article's attribution line.
  primarySourceUrl         String?
  // A second, independent reputable source that also discusses this story
  // (any active Source, not just the TIER_1 ones primarySourceUrl draws
  // from) — optional corroboration, recorded for transparency. Never
  // required for PRIMARY_SOURCE_CONFIRMED: an official primary source is
  // treated as sufficient on its own (breaking company-announcement news
  // often has no second source yet).
  secondarySourceUrl       String?
  // Plain-English explanation from the verification LLM call, kept for
  // editor transparency even when verification did not lead to publish.
  verificationNotes        String?
  // AI-reported confidence (0-100) — an editorial/transparency signal only.
  // The auto-publish gate (lib/verification-actions.ts) never reads this
  // field; it gates on verificationStatus + evaluatePublicationChecks
  // alone, so a high self-reported confidence can never substitute for the
  // real checks.
  verificationConfidence   Int?
  // The specific factual claims the AI compared against the source(s), for
  // editor transparency — not itself treated as proof of anything.
  claimsChecked            Json?
  // 0-1 max word-shingle similarity between the draft and the actual
  // verification source text (lib/ai/originality-check.ts) — the
  // mechanical, code-enforced backstop for the "never copy verbatim"
  // prompt rule. Unlike verificationConfidence, THIS field does gate
  // auto-publish: see the "originality" check in lib/publication-checks.ts.
  originalityScore         Float?
  verifiedAt               DateTime?
  // Links back to the exact AIGeneration row (model, prompt, raw output)
  // that produced this article's verification/synthesis — full audit
  // traceability without duplicating the model name as a separate field.
  verificationGenerationId String?                   @unique
  verificationGeneration   AIGeneration?             @relation(fields: [verificationGenerationId], references: [id], onDelete: SetNull)

  // Editorial priority signals (Pakistan-first strategy). 0-100. Populated
  // manually, or by the deterministic discovery scoring in lib/discovery/*.
  pakistanRelevance  Int @default(0)
  regionalRelevance  Int @default(0)
  globalSignificance Int @default(0)

  // Real, honestly-earned engagement signal — incremented on article view.
  // Never seeded with fabricated numbers. Trending falls back to this plus
  // recency when no manual trendingRank override is set.
  views        Int  @default(0)
  trendingRank Int?

  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  readingTime Int?

  categoryId                  String
  category                    Category @relation(fields: [categoryId], references: [id])
  authorId                    String
  author                      Author   @relation(fields: [authorId], references: [id])
  // True only when the saved (authorId, categoryId) pairing was ineligible
  // (lib/author-eligibility.ts) and an ADMIN explicitly overrode it via
  // CAN_OVERRIDE_AUTHOR_ELIGIBILITY. Recomputed on every create/update save.
  authorEligibilityOverridden Boolean  @default(false)

  // Login account that created this article — distinct from `author` (the
  // public byline). Used for "reporters/researchers can only edit their own
  // drafts, and only before they're submitted for review".
  // Null for the seeded demo articles, which have no owning newsroom user.
  createdById String?
  createdBy   User?   @relation("ArticleCreatedBy", fields: [createdById], references: [id])

  locationName String?

  featuredImageUrl     String?
  featuredImageAlt     String?
  featuredImageCaption String?
  featuredImageCredit  String?

  // Purely an optional provenance cross-reference for the CMS — the fields
  // above remain the actual rendering source of truth and are unaffected.
  // Null whenever the image came from a hand-typed URL (no provenance to
  // show) or there is no featured image at all. Kept in lockstep with
  // featuredImageUrl by lib/article-actions.ts on every edit — see the
  // Non-negotiable invariant in the image-acquisition plan.
  featuredMediaId String?
  featuredMedia   Media?  @relation(fields: [featuredMediaId], references: [id], onDelete: SetNull)

  // Reverse of Media.articleId — every Media row a human tagged for this
  // article, not just the current featured image.
  taggedMedia Media[] @relation("MediaTaggedForArticle")

  seoTitle        String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?

  verification VerificationStatus @default(PENDING)
  aiStatus     AIStatus           @default(NOT_STARTED)

  // Postgres-generated tsvector (see prisma/migrations follow-up SQL) powering
  // real relevance-ranked search. Unsupported = Prisma never manages its DDL,
  // so hand-written GENERATED ALWAYS AS ... STORED column survives migrate dev.
  searchVector Unsupported("tsvector")?

  sources       ArticleSource[]
  tags          ArticleTag[]
  versions      ArticleVersion[]
  relatedFrom   Relation[]       @relation("from")
  relatedTo     Relation[]       @relation("to")
  convertedFrom SourceItem[]     @relation("SourceItemConvertedArticle")
  digestItems   DigestItem[]
  pageViews     PageView[]

  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
  @@index([pakistanRelevance, publishedAt])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model Source {
  id               String          @id @default(cuid())
  name             String
  url              String
  feedUrl          String?
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id])
  type             SourceType
  tier             SourceTier      @default(TIER_3)
  active           Boolean         @default(true)
  language         String?
  country          String?
  reliabilityNotes String?
  lastChecked      DateTime?
  lastSuccess      DateTime?
  lastError        String?
  items            SourceItem[]
  articles         ArticleSource[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model SourceItem {
  id              String    @id @default(cuid())
  sourceId        String
  source          Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String?
  sourceUrl       String
  canonicalUrl    String?
  headline        String
  normalizedTitle String
  excerpt         String?
  publishedAt     DateTime?
  imageUrl        String?
  rawMetadata     Json?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  clusterId String?
  cluster   StoryCluster? @relation(fields: [clusterId], references: [id])

  pakistanRelevance     Int                  @default(0)
  pakistanImpactLevel   PakistanImpactLevel?
  pakistanImpactReasons Json?

  duplicateScore Float        @default(0)
  duplicateOfId  String?
  duplicateOf    SourceItem?  @relation("SourceItemDuplicateOf", fields: [duplicateOfId], references: [id])
  duplicatesOfMe SourceItem[] @relation("SourceItemDuplicateOf")

  priorityScore   Float @default(0)
  priorityReasons Json?

  status   DiscoveryStatus @default(NEW)
  aiStatus AIStatus        @default(NOT_STARTED)

  convertedArticleId String?
  convertedArticle   Article? @relation("SourceItemConvertedArticle", fields: [convertedArticleId], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   User?   @relation("SourceItemReviewedBy", fields: [reviewedById], references: [id])
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimSources  ClaimSource[]
  digestItems   DigestItem[]
  acquiredMedia Media[]

  @@unique([sourceId, sourceUrl])
  @@index([publishedAt])
  @@index([status])
  @@index([clusterId])
}

model StoryCluster {
  id             String @id @default(cuid())
  title          String
  importance     Float  @default(0)
  duplicateScore Float  @default(0)

  pakistanRelevance   Int                  @default(0)
  pakistanImpactLevel PakistanImpactLevel?

  verification VerificationStatus @default(PENDING)
  notes        ResearchNote[]
  items        SourceItem[]
  claims       Claim[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ResearchNote {
  id        String       @id @default(cuid())
  clusterId String
  cluster   StoryCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  note      String
  verified  Boolean      @default(false)
  createdAt DateTime     @default(now())
}

model Claim {
  id             String       @id @default(cuid())
  clusterId      String
  cluster        StoryCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  text           String
  type           ClaimType    @default(CLAIM)
  // False means an active, unresolved contradiction exists (a
  // SUPPORTING and a CONTRADICTING source both attached) — this is what
  // blocks "Create Draft" until an editor explicitly clears it.
  resolved       Boolean      @default(true)
  resolutionNote String?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sources ClaimSource[]
}

model ClaimSource {
  claimId      String
  claim        Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sourceItemId String
  sourceItem   SourceItem  @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  stance       ClaimStance

  @@id([claimId, sourceItemId])
}

model AIGeneration {
  id            String   @id @default(cuid())
  task          AITask
  model         String
  status        AIStatus @default(NOT_STARTED)
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  inputRef      Json?
  output        Json?
  errorMessage  String?
  createdAt     DateTime @default(now())

  verifiedArticle Article?
}

model Keyword {
  id        String      @id @default(cuid())
  term      String      @unique
  type      KeywordType
  priority  Boolean     @default(false)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  // Scopes a TOPIC-type keyword to one category's Google News query
  // (lib/ingestion/google-news.ts's buildGoogleNewsQuery) — irrelevant to
  // PAKISTAN/COMPANY-type keywords, which keep their existing global
  // relevance-scoring role regardless of this field.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
}

model Digest {
  id          String       @id @default(cuid())
  digestDate  DateTime     @unique
  status      DigestStatus @default(DRAFT)
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       DigestItem[]
}

model DigestItem {
  id           String        @id @default(cuid())
  digestId     String
  digest       Digest        @relation(fields: [digestId], references: [id], onDelete: Cascade)
  sourceItemId String?
  sourceItem   SourceItem?   @relation(fields: [sourceItemId], references: [id])
  articleId    String?
  article      Article?      @relation(fields: [articleId], references: [id], onDelete: SetNull)
  section      DigestSection
  order        Int           @default(0)
  addedById    String
  addedBy      User          @relation(fields: [addedById], references: [id])
  createdAt    DateTime      @default(now())
}

model ArticleSource {
  articleId String
  sourceId  String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

model ArticleVersion {
  id            String        @id @default(cuid())
  articleId     String
  article       Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editorId      String
  editor        User          @relation(fields: [editorId], references: [id])
  versionNumber Int
  status        ArticleStatus
  title         String
  // Full editable-field snapshot (subheadline, excerpt, content blocks,
  // categoryId, authorId, tag ids, image fields, seo fields, locationName) —
  // enough to actually restore a version, not just the body text.
  snapshot      Json
  changeSummary String?
  createdAt     DateTime      @default(now())

  @@unique([articleId, versionNumber])
  @@index([articleId, createdAt])
}

model Relation {
  fromId String
  toId   String
  from   Article @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to     Article @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  score  Float   @default(0)

  @@id([fromId, toId])
}

model Media {
  id           String   @id @default(cuid())
  url          String
  altText      String
  caption      String?
  credit       String?
  license      String?
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  // Provenance for automatically acquired images (lib/images/acquire.ts).
  // All null for a plain editor upload via /api/media/upload.
  sourceItemId     String?
  sourceItem       SourceItem? @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  sourceUrl        String? // the original remote image URL it was downloaded from
  sourceArticleUrl String? // the article page it was found on
  sourceDomain     String? // that page's hostname, for publication attribution

  // Which article a manual upload was tagged for at upload time (set from
  // ArticleEditor's own Featured Image panel, or picked explicitly on the
  // Media Library page) — distinct from sourceItemId (automated-acquisition
  // provenance) and from being any article's CURRENT featuredMediaId (which
  // can change independently after this upload). Lets a human-sourced image
  // surface in that specific article's "choose from article images" picker
  // even before the article has been saved with it as the featured image.
  articleId   String?
  article     Article? @relation("MediaTaggedForArticle", fields: [articleId], references: [id], onDelete: SetNull)
  // SHA-256 of the downloaded bytes. Nullable-unique: Postgres allows many
  // nulls (editor uploads don't compute one) but enforces uniqueness among
  // non-null values, which is what powers acquisition-time dedup.
  contentHash String?  @unique

  // The safety-critical field — see the Non-negotiable invariant. Defaults
  // to UNKNOWN (non-publishable); the manual-upload route explicitly sets
  // ALLOWED (a human already chose to upload it). Acquisition never sets
  // anything better than LICENSED on an explicit, machine-readable grant —
  // everything else it finds lands in REQUIRES_REVIEW.
  reuseStatus ImageReuseStatus @default(UNKNOWN)
  reuseNotes  String?

  // The winning candidate's ranking outcome, same {score, reasons} shape as
  // lib/discovery's deterministic scoring — why this image was selected.
  selectionScore   Float?
  selectionReasons Json?

  featuredOnArticles Article[]

  @@index([sourceItemId])
  @@index([reuseStatus])
}

model NewsletterSubscriber {
  id               String                     @id @default(cuid())
  email            String                     @unique
  // Double opt-in lifecycle: PENDING (signed up, not yet confirmed) ->
  // CONFIRMED (clicked the confirmation link — the only status eligible for
  // campaign sends) -> UNSUBSCRIBED. Replaces the old single-opt-in
  // `active: Boolean`.
  status           NewsletterSubscriberStatus @default(PENDING)
  // One-click unsubscribe, no login required — generated at signup, included
  // in every campaign/welcome email.
  unsubscribeToken String                     @unique
  createdAt        DateTime                   @default(now())

  confirmationTokens NewsletterConfirmationToken[]
}

model NewsletterConfirmationToken {
  id           String               @id @default(cuid())
  subscriberId String
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  // Only the HMAC hash is stored — same pattern as PasswordResetToken —
  // so a leaked DB row never yields a usable token. Can't reuse
  // PasswordResetToken itself: its userId FK points at User, and newsletter
  // subscribers aren't users.
  tokenHash    String               @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime             @default(now())

  @@index([subscriberId])
}

model PasswordResetToken {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Only the HMAC hash is stored — same pattern as Session.tokenHash — so a
  // leaked DB row never yields a usable token.
  tokenHash String               @unique
  purpose   PasswordResetPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model EmailLog {
  id          String      @id @default(cuid())
  to          String
  subject     String
  status      EmailStatus
  error       String?
  relatedType String?
  relatedId   String?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
}

model NewsletterCampaign {
  id             String                   @id @default(cuid())
  subject        String
  bodyHtml       String
  status         NewsletterCampaignStatus @default(DRAFT)
  createdById    String
  createdBy      User                     @relation(fields: [createdById], references: [id])
  sentAt         DateTime?
  recipientCount Int?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model SystemEvent {
  id        String           @id @default(cuid())
  level     SystemEventLevel
  source    String
  message   String
  context   Json?
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  // Raw view-event log — not deduplicated for bots/crawlers/refreshes, not a
  // unique-visitor count. Every UI surface must label it "page views," never
  // "readers"/"users". No IP/UA stored, by design (privacy-neutral by default).
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([createdAt])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// TEKZARO sells ad placements by direct arrangement (see app/(site)/advertise
// — "email us for rates and placements"), not self-serve checkout, so there
// is deliberately no payment/billing model here: an Advertiser and its
// AdCampaigns are entered by staff once a deal is agreed, mirroring how
// NewsletterCampaign is staff-authored rather than self-service.
model Advertiser {
  id           String           @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  notes        String?
  status       AdvertiserStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  campaigns AdCampaign[]
}

model AdCampaign {
  id           String     @id @default(cuid())
  name         String
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id])

  status     AdCampaignStatus @default(DRAFT)
  placement  AdPlacement
  // null = eligible on every category's CATEGORY_TOP/ARTICLE_END slots, not
  // just one — mirrors Author.categories' "empty = unrestricted" convention.
  categoryId String?
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  startDate DateTime
  endDate   DateTime
  // Higher wins when more than one APPROVED, in-range campaign competes for
  // the same slot; ties are rotated across requests, not always the same
  // winner — see resolveActiveCampaigns in lib/ads.ts.
  priority  Int      @default(0)

  createdById     String
  createdBy       User    @relation("AdCampaignCreatedBy", fields: [createdById], references: [id])
  reviewedById    String?
  reviewedBy      User?   @relation("AdCampaignReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creative    AdCreative?
  impressions AdImpression[]
  clicks      AdClick[]

  @@index([status, placement])
  @@index([categoryId])
}

// One creative per campaign — a real advertiser swaps creative by editing
// this row (a new upload replaces the old URL); TEKZARO doesn't run
// multi-variant creative rotation within a single campaign today, so
// modeling a many-creatives relation now would be speculative.
model AdCreative {
  id         String     @id @default(cuid())
  campaignId String     @unique
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  imageUrl   String
  altText    String
  targetUrl  String
  createdAt  DateTime   @default(now())
}

// Raw delivery-event log, same shape/philosophy as PageView — counted live
// via groupBy/count (lib/ads.ts), not pre-aggregated into a rollup table.
model AdImpression {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  path       String
  createdAt  DateTime   @default(now())

  @@index([campaignId, createdAt])
}

model AdClick {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  path       String
  createdAt  DateTime   @default(now())

  @@index([campaignId, createdAt])
}
