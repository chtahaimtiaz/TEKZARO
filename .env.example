DATABASE_URL="postgresql://user:password@localhost:5432/tekzaro"
NEXT_PUBLIC_SITE_URL="https://example.com"
AI_API_KEY=""
SEARCH_API_KEY=""
NEWS_API_KEY=""
AUTH_SECRET="generate-a-long-random-value-e.g.-openssl-rand-base64-48"

# Scheduled publishing — bearer token /api/cron/publish-scheduled checks
# against the Authorization header. Required for the cron route to do
# anything; generate a long random value.
CRON_SECRET=""

# Media storage (see lib/media/storage.ts). "local" writes to public/uploads
# — correct for local dev and a self-hosted, persistent-filesystem
# deployment, but Vercel's serverless filesystem is ephemeral, so uploads
# stay BLOCKED on Vercel until this is set to a real durable provider. No
# object-storage adapter is implemented yet (Phase 5 ships the interface +
# guard only) — STORAGE_BUCKET is reserved for whichever provider's config
# that adapter ends up needing.
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""

# Email (invites, password resets, notifications, newsletter) — SMTP, bring
# your own credentials. Every send is honestly gated: unset any of these and
# every email path degrades to "not configured" rather than failing loudly.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional third-party analytics tag on the public site (Plausible-style —
# see app/(site)/layout.tsx). The self-hosted PageView table (/admin/analytics)
# is the primary analytics deliverable and needs no config at all.
NEXT_PUBLIC_ANALYTICS_ID=""

# Bootstrap admin — read once by `npx tsx scripts/create-admin.ts`, not at
# app runtime. Rotate/remove ADMIN_PASSWORD after first login.
ADMIN_NAME="TEKZARO Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="set-a-strong-temporary-password"
