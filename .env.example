DATABASE_URL="postgresql://user:password@localhost:5432/tekzaro"
NEXT_PUBLIC_SITE_URL="https://example.com"
AI_API_KEY=""
# Tavily Search API — used by lib/search/web-search.ts to find a
# primary/official source before TEKZARO auto-publishes a synthesized
# article (see lib/verification-actions.ts). One credential: an API key
# from app.tavily.com. Leave empty to keep verification honestly
# "not configured" rather than faked.
SEARCH_API_KEY=""
NEWS_API_KEY=""
AUTH_SECRET="generate-a-long-random-value-e.g.-openssl-rand-base64-48"

# Scheduled publishing — bearer token /api/cron/publish-scheduled checks
# against the Authorization header. Required for the cron route to do
# anything; generate a long random value.
CRON_SECRET=""

# Max SourceItems verified per /api/cron/verify-and-publish run. Tavily's
# free tier is 1,000 credits/MONTH (not/day), "basic" search_depth costs 1
# credit/call, and this cron runs hourly — 730 hours/month. A batch of 1
# keeps a full month's runs at <=730 credits, leaving real headroom for
# retries, failed requests, and manual testing (a batch of 4, the earlier
# Google-era default, would be ~2,880/month — nearly 3x the free tier).
# Raise deliberately, not by accident: a higher value means real Tavily
# billing ($0.008/credit beyond the free 1,000).
VERIFY_BATCH_SIZE="1"

# Kill switch / gradual rollout for lib/verification-actions.ts's auto-publish
# gate (see the flow diagram in that file). Comma-separated Category slugs —
# only a verified item in one of these categories can ever be auto-published;
# everything else always lands in human review (IN_REVIEW), regardless of how
# confident verification was. Empty (the default) means auto-publish never
# fires anywhere, which is the intended starting state: run in pure
# verify+synthesize -> review mode first, then add categories here one at a
# time once you trust the pipeline for that category specifically.
AUTO_PUBLISH_CATEGORY_SLUGS=""

# Media storage (see lib/media/storage.ts). "local" writes to public/uploads
# — correct for local dev and a self-hosted, persistent-filesystem
# deployment, but Vercel's serverless filesystem is ephemeral, so uploads
# stay BLOCKED on Vercel until this is "vercel-blob" (with a real token
# below). Never silently falls back to local in production.
STORAGE_PROVIDER="local"
# Required only when STORAGE_PROVIDER="vercel-blob" — create a Blob store
# under your Vercel project's Storage tab; it adds this automatically, or
# copy it from there for local testing. Secret — never commit a real value.
BLOB_READ_WRITE_TOKEN=""

# Email (invites, password resets, notifications, newsletter) — SMTP, bring
# your own credentials. Every send is honestly gated: unset any of these and
# every email path degrades to "not configured" rather than failing loudly.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional third-party analytics tag on the public site (Plausible-style —
# see app/(site)/layout.tsx). The self-hosted PageView table (/admin/analytics)
# is the primary analytics deliverable and needs no config at all.
NEXT_PUBLIC_ANALYTICS_ID=""

# Official TEKZARO social profile links, shown in the footer (see
# lib/social-links.ts). These accounts don't exist yet — leave empty. Never
# invent a URL: a platform's icon only appears once its var is set to a real
# profile URL. Add one later and redeploy; no other change needed.
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""

# Bootstrap admin — read once by `npx tsx scripts/create-admin.ts`, not at
# app runtime. Rotate/remove ADMIN_PASSWORD after first login.
ADMIN_NAME="TEKZARO Admin"
ADMIN_EMAIL="admin@tekzaro.co"
ADMIN_PASSWORD="set-a-strong-temporary-password"
